---
import { resolveCollectionImage } from '@/lib/images';

interface Props {
  slug: string;
  title: string;
  description: string;
  hero: string;
  memberCount: number;
}

const { slug, title, description, hero, memberCount } = Astro.props;
const heroSrc = resolveCollectionImage(hero, slug);
---

<a
  href={`/collections/${slug}`}
  class="group block no-underline overflow-hidden rounded-lg"
>
  <div class="aspect-[16/9] overflow-hidden bg-border/30">
    <img
      src={heroSrc}
      alt={title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition duration-200 group-hover:scale-105"
    />
  </div>
  <div class="mt-3 space-y-1">
    <h3 class="text-base font-semibold text-ink group-hover:text-accent transition duration-200">
      {title}
    </h3>
    <p class="text-sm text-muted line-clamp-2">{description}</p>
    <p class="text-xs text-muted">{memberCount} {memberCount === 1 ? 'piece' : 'pieces'}</p>
  </div>
</a>
