---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-paper">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-center sm:text-left">
        <p class="font-serif text-lg font-semibold text-ink">Quill Art by TK</p>
        <p class="text-sm text-muted mt-1">Handmade quilled paper art by Tracey</p>
      </div>

      <div class="flex items-center gap-6">
        <!-- Facebook -->
        <a
          href="https://www.facebook.com/quillartbytk"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition duration-200 no-underline"
          aria-label="Follow on Facebook"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
          </svg>
        </a>

        <!-- Email -->
        <a
          href="/contact"
          class="text-muted hover:text-accent transition duration-200 no-underline"
          aria-label="Contact us"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </a>
      </div>
    </div>

    <p class="text-xs text-muted text-center mt-8">
      &copy; {year} Quill Art by TK. All rights reserved.
    </p>
  </div>
</footer>
