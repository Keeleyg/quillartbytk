---
/**
 * Image lightbox using <dialog>. Include once per product page.
 * Thumbnails should have data-lightbox-src pointing to the full-res image.
 */
---

<dialog
  id="lightbox"
  class="m-0 p-0 w-full h-full max-w-none max-h-none bg-black/90 backdrop:bg-transparent"
>
  <div class="flex items-center justify-center w-full h-full p-4 sm:p-8">
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-white/80 hover:text-white z-10 p-2"
      aria-label="Close lightbox"
    >
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[90vh] object-contain rounded-lg"
    />
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close')!;

  // Open on thumbnail click
  document.querySelectorAll('[data-lightbox-src]').forEach((el) => {
    el.addEventListener('click', () => {
      const src = (el as HTMLElement).dataset.lightboxSrc!;
      const alt = (el as HTMLElement).dataset.lightboxAlt ?? '';
      img.src = src;
      img.alt = alt;
      dialog.showModal();
    });
  });

  // Close on button, backdrop click, or Escape
  closeBtn.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
