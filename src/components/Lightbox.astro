---
/**
 * Image lightbox using <dialog>. Include once per product page.
 * Any element with data-lightbox-src (and optional data-lightbox-alt) becomes
 * a trigger; the lightbox lets you cycle through all of them with the on-screen
 * arrows or the keyboard (← →), wrapping around.
 */
---

<dialog
  id="lightbox"
  class="m-0 p-0 w-full h-full max-w-none max-h-none bg-black/90 backdrop:bg-transparent"
>
  <div id="lightbox-stage" class="relative flex items-center justify-center w-full h-full p-4 sm:p-12">
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-white/80 hover:text-white z-20 p-2"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button
      id="lightbox-prev"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-20 p-2"
      aria-label="Previous image"
    >
      <svg class="w-9 h-9 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[88vh] object-contain rounded-lg"
    />

    <button
      id="lightbox-next"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white z-20 p-2"
      aria-label="Next image"
    >
      <svg class="w-9 h-9 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <div
      id="lightbox-counter"
      class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/80 text-sm bg-black/40 rounded-full px-3 py-1 z-20"
    >1 / 1</div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const stage = document.getElementById('lightbox-stage')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close')!;
  const prevBtn = document.getElementById('lightbox-prev')!;
  const nextBtn = document.getElementById('lightbox-next')!;
  const counter = document.getElementById('lightbox-counter')!;

  // Build the ordered, de-duplicated list of images on the page.
  const items: { src: string; alt: string }[] = [];
  const seen = new Set<string>();
  const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-src]');
  triggers.forEach((el) => {
    const src = el.dataset.lightboxSrc;
    if (!src || seen.has(src)) return;
    seen.add(src);
    items.push({ src, alt: el.dataset.lightboxAlt ?? '' });
  });

  const single = items.length <= 1;
  prevBtn.hidden = single;
  nextBtn.hidden = single;
  counter.hidden = single;

  let index = 0;
  function render() {
    const it = items[index];
    if (!it) return;
    img.src = it.src;
    img.alt = it.alt;
    counter.textContent = `${index + 1} / ${items.length}`;
  }
  function open(i: number) {
    if (!items.length) return;
    index = (i + items.length) % items.length;
    render();
    dialog.showModal();
  }
  const go = (delta: number) => { index = (index + delta + items.length) % items.length; render(); };

  // Open from any trigger
  triggers.forEach((el) => {
    const src = el.dataset.lightboxSrc;
    const handler = () => open(items.findIndex((it) => it.src === src));
    el.addEventListener('click', handler);
    // Keyboard activation for non-button triggers (e.g. the main image div)
    if (el.tagName !== 'BUTTON') {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handler(); }
      });
    }
  });

  // Controls
  prevBtn.addEventListener('click', (e) => { e.stopPropagation(); go(-1); });
  nextBtn.addEventListener('click', (e) => { e.stopPropagation(); go(1); });
  closeBtn.addEventListener('click', (e) => { e.stopPropagation(); dialog.close(); });
  img.addEventListener('click', (e) => e.stopPropagation());
  counter.addEventListener('click', (e) => e.stopPropagation());
  // Click anywhere else on the dark stage closes
  stage.addEventListener('click', () => dialog.close());

  // Keyboard arrows while open (Escape closes natively)
  document.addEventListener('keydown', (e) => {
    if (!dialog.open || single) return;
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
  });

  // Touch swipe (mobile/tablet): swipe left = next, right = previous
  let touchX: number | null = null;
  stage.addEventListener('touchstart', (e) => { touchX = e.changedTouches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    if (touchX === null || single) return;
    const dx = e.changedTouches[0].clientX - touchX;
    touchX = null;
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
  }, { passive: true });
</script>
