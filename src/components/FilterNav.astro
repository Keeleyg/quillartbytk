---
import { VALID_CATEGORIES, VALID_THEMES } from '@/content.config';
import { titleCase, categoryLabel, url } from '@/lib/images';

interface Props {
  currentCategory?: string;
  currentTheme?: string;
}

const { currentCategory, currentTheme } = Astro.props;
const isAllActive = !currentCategory && !currentTheme;
---

<nav class="flex flex-wrap gap-2" aria-label="Filter products">
  <!-- All -->
  <a
    href={url('/gallery')}
    class:list={[
      'inline-flex items-center px-3 py-1 rounded-full text-xs border transition duration-200 no-underline',
      isAllActive
        ? 'bg-ink text-paper border-ink'
        : 'border-border text-muted hover:text-ink hover:border-ink/30',
    ]}
    aria-current={isAllActive ? 'page' : undefined}
  >
    All
  </a>

  <!-- Divider -->
  <span class="text-border self-center" aria-hidden="true">|</span>

  <!-- Categories -->
  {VALID_CATEGORIES.map((cat) => (
    <a
      href={url(`/gallery/category/${cat}`)}
      class:list={[
        'inline-flex items-center px-3 py-1 rounded-full text-xs border transition duration-200 no-underline',
        currentCategory === cat
          ? 'bg-ink text-paper border-ink'
          : 'border-border text-muted hover:text-ink hover:border-ink/30',
      ]}
      aria-current={currentCategory === cat ? 'page' : undefined}
    >
      {categoryLabel(cat)}
    </a>
  ))}

  <!-- Divider -->
  <span class="text-border self-center" aria-hidden="true">|</span>

  <!-- Themes -->
  {VALID_THEMES.map((theme) => (
    <a
      href={url(`/gallery/theme/${theme}`)}
      class:list={[
        'inline-flex items-center px-3 py-1 rounded-full text-xs border transition duration-200 no-underline',
        currentTheme === theme
          ? 'bg-ink text-paper border-ink'
          : 'border-border text-muted hover:text-ink hover:border-ink/30',
      ]}
      aria-current={currentTheme === theme ? 'page' : undefined}
    >
      {titleCase(theme)}
    </a>
  ))}
</nav>
