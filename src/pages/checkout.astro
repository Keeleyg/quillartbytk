---
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/images';

const AU_STATES = ['ACT', 'NSW', 'NT', 'QLD', 'SA', 'TAS', 'VIC', 'WA'];
const inputClass =
  'mt-1 block w-full rounded-lg border border-border bg-paper px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent';
---

<Base title="Checkout" description="Place your order — Tracey will email you a secure payment link to pay by card.">
  <section class="py-16 lg:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink">Checkout</h1>

      <!-- Empty -->
      <div id="checkout-empty" hidden class="mt-8">
        <p class="text-muted">Your cart is empty, so there's nothing to check out.</p>
        <a href={url('/store')} class="mt-4 inline-flex items-center px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200">
          Browse the Store
        </a>
      </div>

      <!-- Success -->
      <div id="checkout-success" hidden class="mt-8 rounded-xl border border-border bg-paper p-6">
        <h2 class="text-xl font-serif font-semibold text-ink">Thank you — your order's in! 🎉</h2>
        <p class="mt-3 text-sm text-muted leading-relaxed">
          Tracey has been notified and will email you a <strong>secure payment link</strong> to pay by card
          (via Zeller). The link will include the final total with postage to your address. Your pieces are
          set aside for you in the meantime.
        </p>
        <p class="mt-3 text-sm text-muted">A confirmation is on its way to your inbox. Nothing is charged yet.</p>
        <a href={url('/store')} class="mt-5 inline-flex items-center px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200">
          Keep browsing
        </a>
      </div>

      <!-- Main: summary + form -->
      <div id="checkout-main" hidden class="mt-8">
        <!-- Order summary -->
        <div class="rounded-xl border border-border p-5">
          <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">Order summary</h2>
          <ul id="summary-items" class="mt-3 divide-y divide-border"></ul>
          <div class="mt-3 pt-3 border-t border-border flex items-center justify-between">
            <span class="text-sm text-muted">Subtotal</span>
            <span id="summary-subtotal" class="text-base font-semibold text-ink"></span>
          </div>
          <p class="mt-2 text-xs text-muted">+ postage — Tracey confirms the final total in your payment link.</p>
          <a href={url('/cart')} class="mt-3 inline-block text-xs text-accent underline">Edit cart</a>
        </div>

        <!-- Details form -->
        <form id="checkout-form" class="mt-8 space-y-5" novalidate>
          <!-- Honeypot (hidden from humans) -->
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;" tabindex="-1">
            <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>

          <fieldset>
            <legend class="text-sm font-semibold text-ink">Your details</legend>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="f-name" class="text-sm text-ink">Full name <span class="text-accent">*</span></label>
                <input id="f-name" name="name" type="text" required maxlength="100" autocomplete="name" class={inputClass} />
              </div>
              <div>
                <label for="f-email" class="text-sm text-ink">Email <span class="text-accent">*</span></label>
                <input id="f-email" name="email" type="email" required maxlength="254" autocomplete="email" class={inputClass} />
              </div>
              <div class="sm:col-span-2">
                <label for="f-phone" class="text-sm text-ink">Phone <span class="text-muted">(optional)</span></label>
                <input id="f-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-semibold text-ink">Shipping address</legend>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label for="f-line1" class="text-sm text-ink">Address line 1 <span class="text-accent">*</span></label>
                <input id="f-line1" name="line1" type="text" required maxlength="200" autocomplete="address-line1" class={inputClass} />
              </div>
              <div class="sm:col-span-2">
                <label for="f-line2" class="text-sm text-ink">Address line 2 <span class="text-muted">(optional)</span></label>
                <input id="f-line2" name="line2" type="text" maxlength="200" autocomplete="address-line2" class={inputClass} />
              </div>
              <div>
                <label for="f-suburb" class="text-sm text-ink">Suburb / town <span class="text-accent">*</span></label>
                <input id="f-suburb" name="suburb" type="text" required maxlength="120" autocomplete="address-level2" class={inputClass} />
              </div>
              <div>
                <label for="f-postcode" class="text-sm text-ink">Postcode <span class="text-accent">*</span></label>
                <input id="f-postcode" name="postcode" type="text" required maxlength="20" autocomplete="postal-code" class={inputClass} />
              </div>
              <div>
                <label for="f-state" class="text-sm text-ink">State <span class="text-accent">*</span></label>
                <select id="f-state" name="state" required class={inputClass}>
                  <option value="">Select…</option>
                  {AU_STATES.map((s) => <option value={s}>{s}</option>)}
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label for="f-country" class="text-sm text-ink">Country <span class="text-accent">*</span></label>
                <input id="f-country" name="country" type="text" required maxlength="80" value="Australia" autocomplete="country-name" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <div>
            <label for="f-notes" class="text-sm text-ink">Notes for Tracey <span class="text-muted">(optional)</span></label>
            <textarea id="f-notes" name="notes" rows="3" maxlength="2000" class={inputClass} placeholder="Gift wrapping, a delivery deadline, personalisation requests…"></textarea>
          </div>

          <p class="text-xs text-muted leading-relaxed">
            No payment is taken on this site and no card details are collected here. After you place your order,
            Tracey emails you a secure Zeller payment link to pay by card.
          </p>

          <p id="checkout-error" hidden class="text-sm text-accent"></p>

          <button id="checkout-submit" type="submit" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 bg-ink text-paper text-sm font-medium rounded-lg hover:bg-ink/90 transition duration-200 disabled:opacity-60">
            Place order
          </button>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var emptyEl = document.getElementById('checkout-empty');
      var mainEl = document.getElementById('checkout-main');
      var successEl = document.getElementById('checkout-success');
      var summaryList = document.getElementById('summary-items');
      var summarySubtotal = document.getElementById('summary-subtotal');
      var form = document.getElementById('checkout-form');
      var submitBtn = document.getElementById('checkout-submit');
      var errEl = document.getElementById('checkout-error');

      function renderSummary() {
        var items = window.Cart.read();
        if (!items.length) {
          emptyEl.hidden = false;
          mainEl.hidden = true;
          return false;
        }
        emptyEl.hidden = true;
        mainEl.hidden = false;
        summaryList.innerHTML = '';
        items.forEach(function (it) {
          var li = document.createElement('li');
          li.className = 'flex items-center justify-between py-2 gap-3';
          var name = document.createElement('span');
          name.className = 'text-sm text-ink truncate';
          name.textContent = it.title || 'Untitled piece';
          var price = document.createElement('span');
          price.className = 'text-sm text-muted flex-shrink-0';
          price.textContent = (typeof it.price === 'number') ? window.Cart.money(it.price) : '—';
          li.appendChild(name);
          li.appendChild(price);
          summaryList.appendChild(li);
        });
        summarySubtotal.textContent = window.Cart.money(window.Cart.subtotal());
        return true;
      }

      function showError(msg) {
        errEl.textContent = msg;
        errEl.hidden = false;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errEl.hidden = true;

        // Honeypot
        if (form.company && form.company.value.trim()) { return; }

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        var items = window.Cart.read();
        if (!items.length) { renderSummary(); return; }

        var payload = {
          customer: {
            name: form.name.value.trim(),
            email: form.email.value.trim(),
            phone: form.phone.value.trim(),
          },
          shipping: {
            line1: form.line1.value.trim(),
            line2: form.line2.value.trim(),
            suburb: form.suburb.value.trim(),
            state: form.state.value.trim(),
            postcode: form.postcode.value.trim(),
            country: form.country.value.trim() || 'Australia',
          },
          items: items.map(function (i) { return { id: i.id, title: i.title, price: i.price }; }),
          notes: form.notes.value.trim(),
        };

        submitBtn.disabled = true;
        submitBtn.textContent = 'Placing order…';
        try {
          var res = await fetch('/api/order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = {};
          try { data = await res.json(); } catch (e2) {}
          if (!res.ok || !data.ok) {
            throw new Error(data.error || 'Something went wrong placing your order. Please try again.');
          }
          window.Cart.clear();
          mainEl.hidden = true;
          successEl.hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          showError(err.message || 'Could not place your order. Please try again shortly.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Place order';
        }
      });

      document.addEventListener('cart:change', function () {
        if (!successEl.hidden) return; // don't disrupt the success screen
        renderSummary();
      });
      renderSummary();
    })();
  </script>
</Base>
