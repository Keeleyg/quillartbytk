---
import Base from '@/layouts/Base.astro';
import FilterNav from '@/components/FilterNav.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { VALID_THEMES } from '@/content.config';
import { titleCase } from '@/lib/images';

export function getStaticPaths() {
  return VALID_THEMES.map((theme) => ({
    params: { theme },
  }));
}

const { theme } = Astro.params;
const allProducts = await getCollection('products');

const includeDrafts = !!import.meta.env.ASTRO_INCLUDE_DRAFTS;
const products = allProducts
  .filter((p) => {
    if (!p.data.themes.includes(theme as any)) return false;
    if (p.data.status === 'available' || p.data.status === 'order') return true;
    if (includeDrafts && p.data.status === 'draft') return true;
    return false;
  })
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const label = titleCase(theme!);
---

<Base title={`Gallery — ${label}`} description={`Browse ${label.toLowerCase()} themed handmade quilled paper art.`}>
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink mb-8">Gallery — {label}</h1>
      <div class="mb-10">
        <FilterNav currentTheme={theme} />
      </div>
      <ProductGrid products={products} />
    </div>
  </section>
</Base>
