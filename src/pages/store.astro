---
import Base from '@/layouts/Base.astro';
import FilterNav from '@/components/FilterNav.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { isAvailable } from '@/lib/products';

const allProducts = await getCollection('products');

// Store: only pieces available to buy now.
const products = allProducts
  .filter(isAvailable)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const emptyMessage =
  "Nothing's available to buy right now — browse the Gallery to see the full collection, or get in touch to commission a piece.";
---

<Base title="Store" description="Handmade quilled paper art available to buy now.">
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink mb-8">Store</h1>
      <div class="mb-10">
        <FilterNav base="store" />
      </div>
      <ProductGrid products={products} emptyMessage={emptyMessage} buyable />
    </div>
  </section>
</Base>
