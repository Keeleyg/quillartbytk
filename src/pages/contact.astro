---
import Base from '@/layouts/Base.astro';
---

<Base title="Contact" description="Get in touch about a commission, purchase, or question.">

  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mx-auto">

        <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink">Get in touch</h1>
        <p class="mt-4 text-muted">
          Interested in a piece, want to discuss a custom commission, or just have a
          question? Fill out the form below and Tracey will get back to you.
        </p>

        <!-- Inquiry form -->
        <!-- Posts to /api/inquiry (Cloudflare Worker, Phase 3).
             In dev, the form will 404 — this is expected until the Worker is deployed. -->
        <form
          id="inquiry-form"
          method="POST"
          action="/api/inquiry"
          class="mt-8 space-y-6"
        >
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-ink">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="mt-1 block w-full rounded-lg border border-border px-4 py-2.5 text-sm text-ink bg-paper placeholder:text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition duration-200"
              placeholder="Your name"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-ink">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1 block w-full rounded-lg border border-border px-4 py-2.5 text-sm text-ink bg-paper placeholder:text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition duration-200"
              placeholder="you@example.com"
            />
          </div>

          <!-- Subject -->
          <div>
            <label for="subject" class="block text-sm font-medium text-ink">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              autocomplete="off"
              class="mt-1 block w-full rounded-lg border border-border px-4 py-2.5 text-sm text-ink bg-paper placeholder:text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition duration-200"
              placeholder="What's this about?"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-medium text-ink">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="mt-1 block w-full rounded-lg border border-border px-4 py-2.5 text-sm text-ink bg-paper placeholder:text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition duration-200 resize-y"
              placeholder="Tell Tracey what you're looking for..."
            ></textarea>
          </div>

          <!-- Honeypot -->
          <input
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="sr-only"
            aria-hidden="true"
          />

          <!-- Submit -->
          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg hover:bg-ink/90 transition duration-200"
          >
            Send message
          </button>

          <!-- States -->
          <div id="form-success" class="hidden rounded-lg bg-green-50 border border-green-200 p-4">
            <p class="text-sm text-green-800 font-medium">Thanks for your message! Tracey will be in touch soon.</p>
          </div>
          <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-4">
            <p class="text-sm text-red-800 font-medium">Something went wrong. Please try again, or email Tracey directly.</p>
          </div>
        </form>

      </div>
    </div>
  </section>

</Base>

<script>
  // Prefill subject from ?ref= query param
  const params = new URLSearchParams(window.location.search);
  const ref = params.get('ref');
  if (ref) {
    const subjectInput = document.getElementById('subject') as HTMLInputElement | null;
    if (subjectInput && !subjectInput.value) {
      subjectInput.value = `Inquiry about: ${ref.replace(/-/g, ' ')}`;
    }
  }

  // Form submission
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success')!;
  const errorEl = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    try {
      const data = new URLSearchParams(new FormData(form) as any);
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString(),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } else {
        errorEl.classList.remove('hidden');
      }
    } catch {
      // Expected to fail in dev (Worker not running). Show error state.
      errorEl.classList.remove('hidden');
    }
  });
</script>
