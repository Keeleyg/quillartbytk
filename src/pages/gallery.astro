---
import Base from '@/layouts/Base.astro';
import FilterNav from '@/components/FilterNav.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '@/lib/products';

const allProducts = await getCollection('products');

// Portfolio: show every piece that isn't hidden (including sold).
const products = allProducts
  .filter(isVisible)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<Base title="Gallery" description="Browse all handmade quilled paper art pieces.">
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink mb-8">Gallery</h1>
      <div class="mb-10">
        <FilterNav />
      </div>
      <ProductGrid products={products} />
    </div>
  </section>
</Base>
