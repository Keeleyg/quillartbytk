---
import Base from '@/layouts/Base.astro';
import CollectionCard from '@/components/CollectionCard.astro';
import { getCollection } from 'astro:content';
import { renderableMemberCount, hasRenderableMembers } from '@/lib/collections';

const allProducts = await getCollection('products');
const allCollections = await getCollection('collections');
// Hide collections with no renderable members; sort the rest by order.
const sorted = allCollections
  .filter((col) => hasRenderableMembers(col, allProducts))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Collections" description="Browse curated collections of handmade quilled paper art.">
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink mb-8">Collections</h1>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map((col) => (
          <CollectionCard
            slug={col.data.slug}
            title={col.data.title}
            description={col.data.description}
            hero={col.data.hero}
            memberCount={renderableMemberCount(col, allProducts)}
          />
        ))}
      </div>
    </div>
  </section>
</Base>
