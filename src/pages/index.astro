---
import Base from '@/layouts/Base.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import CollectionCard from '@/components/CollectionCard.astro';
import { getCollection } from 'astro:content';
import { resolveProductImage, url } from '@/lib/images';
import { isVisible, visibleIdSet } from '@/lib/products';

// Fetch products + collections
const allProducts = await getCollection('products');
const allCollections = await getCollection('collections');
const visible = visibleIdSet(allProducts);

// Visible pieces (not hidden)
const published = allProducts
  .filter(isVisible)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

// Featured pieces: only those explicitly toggled "featured" (and visible).
const featuredItems = allProducts
  .filter((p) => p.data.featured && isVisible(p))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

// Fallback while nothing is curated yet: auto-pick 6 high-confidence, mixed
// categories. As soon as Tracey features any piece, only those show.
let picked = featuredItems;
if (picked.length === 0) {
  const candidates = allProducts
    .filter((p) => p.data.confidence === 'high' && isVisible(p))
    .sort((a, b) => a.data.id.localeCompare(b.data.id));
  const categories = ['framed', 'cards', 'clocks', 'canvas', 'homewares'];
  const auto: typeof candidates = [];
  for (const cat of categories) {
    const item = candidates.find((p) => p.data.category === cat && !auto.includes(p));
    if (item) auto.push(item);
  }
  for (const item of candidates) {
    if (auto.length >= 6) break;
    if (!auto.includes(item)) auto.push(item);
  }
  picked = auto;
}

// Top 3 collections by order
const topCollections = allCollections
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Hero image — P037 Personalised Floral Name Frame (Heidi)
const heidi = allProducts.find((p) => p.data.id === 'P037');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroSrc = heidi ? resolveProductImage(heidi.data.images.main) : `${base}/images/P037/main.jpg`;

// Process images for "How it's made" — pick process-3 (letters), process-4 (details), process-5 (filigree)
const processImages = heidi
  ? [heidi.data.images.process[0], heidi.data.images.process[1], heidi.data.images.process[4]].map(resolveProductImage)
  : [];
const processLabels = ['Laying out the letters', 'Building up the details', 'Dense floral filigree'];
---

<Base title="Quillart by TK" description="Handmade quilled paper art by Tracey — framed pieces, cards, clocks and custom commissions.">

  <!-- Hero -->
  <section class="relative bg-ink/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-semibold text-ink leading-tight">
            Handmade quilled<br />paper art
          </h1>
          <p class="mt-6 text-lg text-muted max-w-lg">
            Each piece is hand-rolled and shaped from paper strips, built up layer by layer
            into colourful, dimensional artworks. Made with care in Australia by Tracey.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={url('/gallery')}
              class="inline-flex items-center px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200"
            >
              Browse gallery
            </a>
            <a
              href={url('/commissions')}
              class="inline-flex items-center px-6 py-3 border border-border text-ink text-sm font-medium rounded-lg no-underline hover:bg-ink/5 transition duration-200"
            >
              Commission a piece
            </a>
          </div>
        </div>
        <div class="aspect-[7/4] rounded-2xl overflow-hidden shadow-lg bg-paper">
          <img
            src={heroSrc}
            alt="Personalised Floral Name Frame — hand-quilled paper art featuring the name Heidi surrounded by pink flowers and filigree"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">Featured pieces</h2>
        <a href={url('/gallery')} class="text-sm text-accent no-underline hover:underline">View all &rarr;</a>
      </div>
      <ProductGrid products={picked} />
    </div>
  </section>

  <!-- How it's made -->
  {processImages.length > 0 && (
    <section class="py-16 lg:py-24 bg-ink/[0.02]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">How it's made</h2>
          <p class="mt-4 text-muted leading-relaxed">
            Each piece starts with thin strips of coloured paper, rolled and shaped by hand
            into hundreds of individual elements, then layered into a dimensional artwork.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {processImages.map((src, i) => (
            <div class="text-center">
              <div class="aspect-square rounded-lg overflow-hidden bg-border/30">
                <img
                  src={src}
                  alt={`Process step ${i + 1}: ${processLabels[i]}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>
              <p class="mt-3 text-sm text-muted">{processLabels[i]}</p>
            </div>
          ))}
        </div>
        <!-- TODO: Tracey to confirm actual hours range -->
        <p class="mt-8 text-center text-sm text-muted">
          Each piece takes between 10 and 40 hours to complete.
        </p>
        <p class="mt-4 text-center">
          <a
            href={url('/products/personalised-floral-name-frame')}
            class="text-sm text-accent no-underline hover:underline"
          >
            See the finished piece &rarr;
          </a>
        </p>
      </div>
    </section>
  )}

  <!-- Collections -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">Collections</h2>
        <a href={url('/collections')} class="text-sm text-accent no-underline hover:underline">See all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {topCollections.map((col) => (
          <CollectionCard
            slug={col.data.slug}
            title={col.data.title}
            description={col.data.description}
            hero={col.data.hero}
            memberCount={col.data.members.filter((id) => visible.has(id)).length}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About snippet -->
  <section class="py-16 lg:py-24 bg-ink/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">About the artist</h2>
        <p class="mt-6 text-muted leading-relaxed">
          <!-- TODO: Tracey to write her own bio -->
          Tracey is a self-taught quilling artist based in Australia, creating intricate paper artworks
          from her home studio. Each piece begins with thin strips of paper that are rolled, shaped
          and glued by hand — a meditative process that can take anywhere from a few hours to several
          weeks depending on the complexity of the design.
        </p>
        <p class="mt-4 text-muted leading-relaxed">
          Her work spans framed wall art, greeting cards, clocks, mini canvases and bespoke
          commissions. Every piece is one of a kind.
        </p>
        <a
          href={url('/about')}
          class="inline-block mt-6 text-sm text-accent no-underline hover:underline"
        >
          Read more &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- CTA strip -->
  <section class="py-16 lg:py-20 bg-accent/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">Want something unique?</h2>
      <p class="mt-4 text-muted max-w-lg mx-auto">
        Commission a custom quilled artwork — personalised names, favourite animals,
        colour palettes to match your space.
      </p>
      <a
        href={url('/contact')}
        class="inline-flex items-center mt-8 px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200"
      >
        Get in touch
      </a>
    </div>
  </section>

</Base>
