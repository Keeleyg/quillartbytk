---
import Base from '@/layouts/Base.astro';
import FilterNav from '@/components/FilterNav.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { VALID_THEMES } from '@/content.config';
import { titleCase } from '@/lib/images';
import { isAvailable } from '@/lib/products';

export function getStaticPaths() {
  return VALID_THEMES.map((theme) => ({
    params: { theme },
  }));
}

const { theme } = Astro.params;
const allProducts = await getCollection('products');

const products = allProducts
  .filter((p) => p.data.themes.includes(theme as any) && isAvailable(p))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const label = titleCase(theme!);
---

<Base title={`Store — ${label}`} description={`Buy ${label.toLowerCase()} themed handmade quilled paper art available now.`}>
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink mb-8">Store — {label}</h1>
      <div class="mb-10">
        <FilterNav base="store" currentTheme={theme} />
      </div>
      <ProductGrid
        products={products}
        emptyMessage={`No ${label.toLowerCase()} pieces available to buy right now — check back soon, or browse the Gallery.`}
      />
    </div>
  </section>
</Base>
