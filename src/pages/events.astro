---
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/images';
import eventsData from '@/data/events.json';

interface MarketEvent {
  id: string;
  name: string;
  date: string;
  venue: string;
  stallNumber: string;
  url: string;
  status: string;
  description: string;
}

const events = eventsData as MarketEvent[];

// Split into upcoming and past based on build date
const today = new Date().toISOString().slice(0, 10);
const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = events
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-AU', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<Base title="Markets & Events" description="Find Quillart by TK at upcoming markets and events. See the artworks in person, chat about commissions, and pick up pieces on the day.">

  <!-- Intro -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink">Markets & events</h1>
        <p class="mt-6 text-lg text-muted leading-relaxed">
          Come see the artworks in person, chat about commissions, and pick up pieces on the day.
        </p>
      </div>
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="py-16 lg:py-24 bg-ink/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink mb-8">Upcoming</h2>

      {upcoming.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcoming.map((evt) => (
            <article
              class:list={[
                'rounded-lg border p-6',
                evt.status === 'cancelled'
                  ? 'border-border/50 bg-paper opacity-60'
                  : 'border-border bg-paper',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-serif font-semibold text-ink">{evt.name}</h3>
                {evt.status === 'cancelled' && (
                  <span class="flex-shrink-0 px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700">
                    Cancelled
                  </span>
                )}
                {evt.status === 'tentative' && (
                  <span class="flex-shrink-0 px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700">
                    TBC
                  </span>
                )}
              </div>
              <div class="mt-3 space-y-1">
                <p class="text-sm font-medium text-ink flex items-center gap-2">
                  <svg class="w-4 h-4 text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  {formatDate(evt.date)}
                </p>
                <p class="text-sm text-muted flex items-center gap-2">
                  <svg class="w-4 h-4 text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {evt.venue}
                </p>
                {evt.stallNumber && (
                  <p class="text-sm text-accent font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016A3.001 3.001 0 0021 9.349m-18 0a2.999 2.999 0 00.72-1.599L4.5 3h15l.78 4.75a2.999 2.999 0 00.72 1.599" />
                    </svg>
                    {evt.stallNumber}
                  </p>
                )}
              </div>
              {evt.description && (
                <p class="mt-4 text-sm text-muted">{evt.description}</p>
              )}
              {evt.url && (
                <a
                  href={evt.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center mt-4 text-sm text-accent no-underline hover:underline"
                >
                  Event details &rarr;
                </a>
              )}
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-border bg-paper p-8 text-center">
          <p class="text-muted">
            No markets currently scheduled. Check back soon, or{' '}
            <a href={url('/commissions')} class="text-accent">start a commission online</a>{' '}
            any time.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Past events -->
  {past.length > 0 && (
    <section class="py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink mb-8">Past events</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {past.map((evt) => (
            <article class="rounded-lg border border-border/50 bg-paper p-6 opacity-60">
              <h3 class="text-lg font-serif font-semibold text-ink">{evt.name}</h3>
              <div class="mt-3 space-y-1">
                <p class="text-sm text-muted">{formatDate(evt.date)}</p>
                <p class="text-sm text-muted">{evt.venue}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-accent/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">Can't make it to a market?</h2>
      <p class="mt-4 text-muted max-w-lg mx-auto">
        Browse the gallery online, or get in touch to commission a custom piece from anywhere.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={url('/gallery')}
          class="inline-flex items-center px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200"
        >
          Browse gallery
        </a>
        <a
          href={url('/contact')}
          class="inline-flex items-center px-6 py-3 border border-border text-ink text-sm font-medium rounded-lg no-underline hover:bg-ink/5 transition duration-200"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>

</Base>
