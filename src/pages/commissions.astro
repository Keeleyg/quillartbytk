---
import Base from '@/layouts/Base.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const commissionExamples = allProducts
  .filter((p) => p.data.commission_example)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<Base title="Commissions" description="Commission a custom quilled paper artwork — personalised names, animals, and more.">

  <!-- Intro -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-ink">Custom commissions</h1>
        <p class="mt-6 text-lg text-muted leading-relaxed">
          Have something specific in mind? Tracey creates made-to-order quilled artworks
          tailored to your vision — personalised names, favourite animals, colour palettes
          to match your space, or a completely original design.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 lg:py-24 bg-ink/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink mb-12 text-center">How it works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto rounded-full bg-accent/10 text-accent flex items-center justify-center font-serif text-xl font-semibold">
            1
          </div>
          <h3 class="mt-4 text-lg font-serif font-semibold text-ink">Get in touch</h3>
          <p class="mt-2 text-sm text-muted">
            Share your idea — a name, a theme, a colour palette, a favourite animal.
            The more detail the better, but a rough idea is a great start too.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto rounded-full bg-accent/10 text-accent flex items-center justify-center font-serif text-xl font-semibold">
            2
          </div>
          <h3 class="mt-4 text-lg font-serif font-semibold text-ink">Design &amp; quote</h3>
          <p class="mt-2 text-sm text-muted">
            Tracey will discuss the design with you, suggest options, and provide a
            quote based on size and complexity. No obligation.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto rounded-full bg-accent/10 text-accent flex items-center justify-center font-serif text-xl font-semibold">
            3
          </div>
          <h3 class="mt-4 text-lg font-serif font-semibold text-ink">Handmade for you</h3>
          <p class="mt-2 text-sm text-muted">
            Your piece is hand-quilled from scratch. You'll receive progress photos
            along the way, and the finished artwork is shipped or available for pickup.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Examples -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink mb-8">Past commissions</h2>
      <ProductGrid products={commissionExamples} />
    </div>
  </section>

  <!-- Pricing & timeline -->
  <section class="py-16 lg:py-24 bg-ink/[0.02]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink mb-6">Pricing &amp; timeline</h2>
        <!-- TODO: Tracey to fill in real pricing and timeline details -->
        <p class="text-muted leading-relaxed">
          Every commission is unique, so pricing depends on the size, complexity and
          framing options you choose. As a rough guide, small framed pieces start from
          around $50 AUD, and larger or more intricate works are quoted individually.
        </p>
        <p class="mt-4 text-muted leading-relaxed">
          Turnaround is typically 2–4 weeks depending on the piece and current workload.
          Rush orders may be possible — just ask.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-20 bg-accent/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-ink">Ready to get started?</h2>
      <p class="mt-4 text-muted">Tell Tracey about your idea and she'll be in touch.</p>
      <a
        href="/contact"
        class="inline-flex items-center mt-8 px-6 py-3 bg-ink text-paper text-sm font-medium rounded-lg no-underline hover:bg-ink/90 transition duration-200"
      >
        Start your commission
      </a>
    </div>
  </section>

</Base>
